# Set these in Render's dashboard (Environment tab), not in a committed file.

PORT=3001

# Your Vercel frontend URL, no trailing slash
FRONTEND_URL=https://boxd-up.vercel.app

# Paste the ENTIRE contents of your Firebase service account JSON here as a
# single line (Firebase Console > Project Settings > Service Accounts >
# Generate new private key). Render supports multi-line env vars too, so
# pasting the raw JSON as-is also works.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"boxdup-9ac42","...":"..."}
